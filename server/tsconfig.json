{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "jsx": "react",
    "paths": {
      "@/*": ["src/*"],
      "@shared/*": ["../shared/dist/*"]
    }
  },
  "include": ["src/**/*"]
}
